# Supabase project that holds the permits table.
SUPABASE_URL=https://your-project.supabase.co
# Either a new-format secret key (sb_secret_...) or the legacy service_role JWT.
# _shared/supabase.mts detects which and sets the right header. The production
# project currently uses the legacy JWT (sb_secret_ keys 401 until enabled in
# the Supabase dashboard under Settings > API Keys).
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret for the geocode endpoints. Any long random string.
IMPORT_SECRET=

# How far back the importer pulls issued permits, in months.
IMPORT_WINDOW_MONTHS=18

# Stadia Maps API key for the basemap tiles. Optional locally (Stadia serves
# keyless from localhost); required in production, domain-restricted to the
# deployed host. Free tier: https://stadiamaps.com
VITE_STADIA_API_KEY=
